{
  "include": ["src/**/*.ts", "../src/map-generation/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "../src/**/*.test.ts",
    "../src/map-generation/aiPlannerClient.ts",
    "../src/map-generation/kiPlannerClient.ts",
    "../src/map-generation/kiDesign.ts",
    "../src/map-generation/quality.ts",
    "../src/map-generation/mapDefinitionAdapter.ts",
    "../src/map-generation/service.ts"
  ],
  "compilerOptions": {
    "rootDir": "..",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true
  }
}
